APP_NAME=monelytics
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=ja
APP_FALLBACK_LOCALE=ja
APP_TIMEZONE=Asia/Tokyo

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=monelytics
DB_USERNAME=webapp
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
CACHE_STORE=redis
QUEUE_CONNECTION=sync

# phpredis 拡張は入れていないため predis を使う。
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

MAIL_MAILER=log
MAIL_HOST=localhost
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=notice@monelytics.local
MAIL_FROM_NAME="${APP_NAME}"

# 問い合わせ通知の宛先
NOTICE_CONTACT=
# 休日判定に使う Google カレンダー
GOOGLE_API_KEY=
