# コンテナの webapp を焼くときの uid/gid (compose.yml が読む。Laravel は
# 使わない)。チェックアウトの所有者と揃えないと、生成物の所有者がずれて
# storage への書き込みが Permission denied になる。id -u / id -g の値を入れる。
WEBAPP_UID=1000
WEBAPP_GID=1000

APP_NAME=monelytics
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=ja
APP_FALLBACK_LOCALE=ja
APP_TIMEZONE=Asia/Tokyo

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=monelytics
DB_USERNAME=webapp
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
# HTTPS で公開する環境では true にする。http のローカル開発では
# クッキーが送られなくなるため false のままにしておく。
SESSION_SECURE_COOKIE=false
CACHE_STORE=redis
QUEUE_CONNECTION=sync

# phpredis 拡張は入れていないため predis を使う。
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379
# compose が redis へ --requirepass として渡す値でもある (compose.yml 参照)。
# 空のままだと docker compose up が止まる。null と書くと Laravel はそれを
# 「パスワードなし」と解釈する一方、サーバ側は文字列 null を要求するため、
# 認証が噛み合わずに接続できない。実際の値を入れること。
REDIS_PASSWORD=

MAIL_MAILER=log
MAIL_HOST=localhost
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=notice@monelytics.local
MAIL_FROM_NAME="${APP_NAME}"

# 問い合わせ通知の宛先
NOTICE_CONTACT=