# バックアップの設定。backup.env にコピーして書き換える (backup.env は git 管理外)。

# ローカルの保存先と保持日数。この日数より前の世代はローカル・リモート双方から消える。
BACKUP_DIR="/home/ubuntu/backups/monelytics"
RETENTION_DAYS="30"

# バックアップ対象。
DB_CONTAINER="monelytics_db"
DB_NAME="monelytics"

# OCI Object Storage。OS_BUCKET を空にするとアップロードを行わず、
# ローカル保存だけで完結する。
OS_BUCKET="monelytics-backup"
OS_PREFIX="mysql"

# 認証は OCI CLI の API キー。設定は ~/.oci/config にあり、この repo には置かない。
# cron には環境変数がほとんど渡らないため、どちらも絶対パスで指定する。
OCI_BIN="/home/ubuntu/bin/oci"
OCI_CLI_CONFIG_FILE="/home/ubuntu/.oci/config"
