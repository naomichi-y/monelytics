[mysqld]
character_set_server = utf8mb4
collation_server = utf8mb4_unicode_ci

# 元の構成は general_log を有効にしていたが、常時稼働では出力量が過大なため無効にした。
# スロークエリログも無効。MariaDB 12 のイメージは mysql ユーザーで動くため /dev/stdout へ
# 書き込めず (Errcode: 13)、有効にすると mariadb-upgrade まで巻き込んで失敗する。
slow_query_log = false

performance_schema = false
