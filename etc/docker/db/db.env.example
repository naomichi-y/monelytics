# db.env としてコピーし、値を設定する。
# Laravel の .env が compose の既定変数ファイルと衝突するため、DB の認証情報はここに分離する。
#
# WEBAPP_PASSWORD は .env の DB_PASSWORD と同じ値にする。初回起動時に
# docker-entrypoint-initdb.d/00-create_user.sh が読み、webapp ユーザを作る。
# 以前はこのパスワードを 00-create_user.sql へ直書きしていたため、git の履歴に
# 平文で残った。値を置いてよいのはこのファイル (git 管理外) だけ。
MARIADB_ROOT_PASSWORD=change_me
WEBAPP_PASSWORD=change_me
